# Public Mapbox token (pk.…) — URL-RESTRICT this token in your Mapbox account
# so it only works on your domains. A leaked restricted pk token is inert.
PUBLIC_MAPBOX_TOKEN=

# Secret token (sk.…) — ONLY if the data pipeline needs Mapbox APIs.
# Never referenced by src/. Never needed at build or runtime.
MAPBOX_SECRET_TOKEN=

# Dev/preview port. Defaults to 4321 when unset. Set it only if 4321 is taken —
# the server fails loudly on a busy port rather than silently moving, so that a
# test pointed at 4321 can never end up asserting against someone else's site.
PORT=
